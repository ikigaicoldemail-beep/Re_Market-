APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=Asia/Singapore

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=marketplace
LOG_STACK=single
LOG_MARKETPLACE_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_backend
DB_USERNAME=marketplace
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

AUTH_GUARD=api
JWT_SECRET=
ADMIN_REGISTRATION_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_HEADERS=*
CORS_SUPPORTS_CREDENTIALS=false

API_RATE_LIMIT=120
AUTH_RATE_LIMIT=20
CHAT_RATE_LIMIT=60
PUBLIC_SEARCH_RATE_LIMIT=90
SOCIAL_RATE_LIMIT=30
AI_RATE_LIMIT=20

# Set to 'huggingface-clip' for real image embeddings (requires AI_SIMILARITY_API_KEY).
# Get a free token at https://huggingface.co/settings/tokens (role: read).
# After switching from fake -> huggingface, run: php artisan ai:reembed-products
AI_SIMILARITY_PROVIDER=fake-image-embedding
AI_SIMILARITY_MODEL=facebook/data2vec-vision-base
AI_SIMILARITY_API_KEY=
AI_SIMILARITY_ENDPOINT=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=v22.0
MARKETPLACE_FACEBOOK_SOCIAL_ACCOUNT_ID=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
